# Never point this value at the developer or production database.
# The database name must contain "test" or "pytest".
TEST_DATABASE_URL=postgresql://app_user:change_me@127.0.0.1:5432/app_db_mbti_pytest

# Unit-test imports keep the application pool lazy.
DB_POOL_MIN_SIZE=0

# Real provider calls are disabled unless a test is explicitly marked "llm".
DEEPSEEK_API_KEYS=
MBTI_ENABLED=false
