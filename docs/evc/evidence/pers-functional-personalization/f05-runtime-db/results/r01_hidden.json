      "participant_payload": {
        "title": "Неоднозначный запрос заказчика",
        "source": {
          "file": "sources/generated-910cb88c987a3eb6af8135c4594e35530b91df2fec1ba919e36f6e88dfaaaf87.json",
          "sha256": "910cb88c987a3eb6af8135c4594e35530b91df2fec1ba919e36f6e88dfaaaf87",
          "pointer": ""
        },
        "case_id": "CASE.SPEC.01",
        "trigger": "Поступает первоначальное обращение; специалист начинает уточнение в текстовом рабочем разговоре.",
        "version": "v0.2",
        "case_version": "v0.5",
        "introduction": "Вы — бизнес-аналитик учебной организации. Елена, руководитель отдела планирования, обратилась к вам по поводу используемой отчётности. Вы готовите собственную рекомендацию и основу дальнейшего предложения. Можно задавать вопросы, запрашивать сведения и предлагать следующие действия; утверждать бюджет, загрузку других сотрудников и обязательства исполнителей вы не можете.\nПроведите первичный разговор с Еленой в этом текстовом чате и предложите следующий шаг. Встречи и отправку файлов за пределами чата выполнять не требуется. Все имена, события и документы учебные.",
        "assessee_task": "Проведите первичный разговор с заказчиком, проясните запрос и предложите следующий шаг. Вопросы и проверка понимания возможны в текущем чате.",
        "substitutions": [],
        "assessee_position": "Специалист проясняет запросы внутреннего или внешнего заказчика и готовит собственную профессиональную рекомендацию. Оцениваемый действует в пределах своей ответственности; дополнительные полномочия из названия должности не выводятся.",
        "initial_materials": [
          {
            "text": "Добрый день! Нам нужно в течение месяца обновить отчётность, чтобы сводка больше не останавливалась и всё обошлось без сложного проекта. Сейчас пользуемся общей таблицей, но за последние четыре недели дважды не смогли вовремя подготовить сводку. Хотелось бы понять, что вы можете предложить. План расходов ещё согласуется.",
            "title": "Письмо Елены",
            "source": {
              "file": "sources/generated-910cb88c987a3eb6af8135c4594e35530b91df2fec1ba919e36f6e88dfaaaf87.json",
              "sha256": "910cb88c987a3eb6af8135c4594e35530b91df2fec1ba919e36f6e88dfaaaf87",
              "pointer": "/Материалы/1"
            },
            "material_id": "M01"
          }
        ],
        "initial_situation": "Заказчик связывает изменение рабочего средства или процесса с устранением затруднений. Он неоднозначно обозначает срок, ожидаемый эффект и сложность. Причина затруднений ещё не установлена; содержание дальнейшего предложения открыто.",
        "assessment_situation_id": "AS.SPEC.01.FUNCTIONAL.20261022",
        "conditions_and_constraints": "{'Язык': 'Профессиональное содержание узнаваемо по деятельности; необходимые термины объяснены. Поиск в интернете и знание скрытой отраслевой формулы не требуются.', 'Мандат': 'Собственная профессиональная рекомендация и вклад; чужие ресурсы, обязательства и внешние подтверждения требуют согласования.', 'Ресурсы': 'Конкретные единицы, доступность, трудозатраты, горизонты и согласующие заданы в AS до старта. Сохраняются отношения из инвариантов; деньги, ИТ и точные часы прежних примеров не обязательны.', 'Информация': {'На старте': ['P00', 'M01'], 'Функции материалов': {'M01': 'Полное первоначальное обращение с неоднозначными выражениями', 'M02': 'Независимый черновик планирования, созданный до разговора; смешивает срок подготовки и реализации, превращает желаемый эффект в гарантию', 'P00': 'Роль, мандат и открытая задача разговора'}}, 'Исполнение': 'Разговор и работа с документами в текущем текстовом интерфейсе; реальные встречи, отправки, изменения систем и проверки за пределами сцены не требуются.', 'Неизвестное': 'Непроверенные причины, будущие результаты и решения не создавать по запросу участника; фиксированные сведения и их раскрытие описать до старта.'}",
        "participants_and_positions": "[{'Функция': 'Заказчик', 'Конкретизация': 'Имя, профессиональная принадлежность, фиксированные знания и мандат определяются в AS; число активных персонажей сохраняется.', 'Позиция и вклад': 'Источник уточнения смысла и собственного рабочего интереса'}, {'Функция': 'Автор черновика', 'Конкретизация': 'Имя, профессиональная принадлежность, фиксированные знания и мандат определяются в AS; число активных персонажей сохраняется.', 'Позиция и вклад': 'Другая сторона планирования; не активный собеседник'}]"
      }
