#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

git diff --cached --check

staged_frontend_sources="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^web/js/' || true)"
staged_frontend_build="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^web/dist/' || true)"

if [ -n "$staged_frontend_sources" ] && [ -z "$staged_frontend_build" ]; then
  echo "Frontend sources changed, but web/dist is not staged." >&2
  echo "Run 'npm run build:web' and stage web/dist before committing." >&2
  exit 1
fi
