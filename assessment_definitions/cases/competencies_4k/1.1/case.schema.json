          "type": "integer"
        },
        "rules": {
          "minLength": 1,
          "title": "Rules",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceRefV2"
        },
        "step_id": {
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
