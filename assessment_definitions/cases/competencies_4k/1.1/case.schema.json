{
  "$defs": {
    "Applicability": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "pattern": "^K[1-4]\\.C\\d{2}$",
          "title": "Component Id",
          "type": "string"
        },
        "required": {
          "const": true,
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "skill_id": {
          "pattern": "^K[1-4]\\.\\d+$",
          "title": "Skill Id",
          "type": "string"
        }
      },
      "required": [
        "skill_id",
        "component_id"
      ],
      "title": "Applicability",
      "type": "object"
    },
    "CaseCharacterV2": {
      "additionalProperties": false,
      "properties": {
        "character_id": {
          "minLength": 1,
          "title": "Character Id",
          "type": "string"
        },
        "closed_card": {
          "minLength": 1,
          "title": "Closed Card",
          "type": "string"
        },
        "name_and_role": {
          "minLength": 1,
          "title": "Name And Role",
          "type": "string"
        },
        "order": {
          "exclusiveMinimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "public_position": {
          "minLength": 1,
          "title": "Public Position",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceRefV2"
        }
      },
      "required": [
        "character_id",
        "order",
        "name_and_role",
        "public_position",
        "closed_card",
        "source"
      ],
      "title": "CaseCharacterV2",
      "type": "object"
    },
    "CaseMaterialV2": {
      "additionalProperties": false,
      "properties": {
        "classification_status": {
          "enum": [
            "structured",
            "source_unresolved"
          ],
          "title": "Classification Status",
          "type": "string"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "disclosure_condition": {
          "additionalProperties": true,
          "title": "Disclosure Condition",
          "type": "object"
        },
        "event_condition": {
          "additionalProperties": true,
          "title": "Event Condition",
          "type": "object"
        },
        "internal_rule": {
          "minLength": 1,
          "title": "Internal Rule",
          "type": "string"
        },
        "kind": {
          "enum": [
            "data",
            "mandatory_update",
            "conditional_material",
            "internal_check",
            "model_rules",
            "model_check",
            "character_reaction",
            "mixed_source"
          ],
          "title": "Kind",
          "type": "string"
        },
        "material_id": {
          "minLength": 1,
          "title": "Material Id",
          "type": "string"
        },
        "participant_payload": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Participant Payload"
        },
        "reaction_rule": {
          "minLength": 1,
          "title": "Reaction Rule",
          "type": "string"
        },
        "result_check": {
          "minLength": 1,
          "title": "Result Check",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceRefV2"
        },
        "speaker_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
