      "type": "object"
    },
    "SourceRefV2": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "row": {
          "exclusiveMinimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "sheet": {
          "minLength": 1,
          "title": "Sheet",
          "type": "string"
        }
