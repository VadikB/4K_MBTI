          "minItems": 1,
          "title": "Scenario Locations",
          "type": "array"
        },
        "skill_id": {
          "pattern": "^K[1-4]\\.\\d+$",
          "title": "Skill Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceRefV2"
        },
        "validity_risk": {
          "minLength": 1,
          "title": "Validity Risk",
          "type": "string"
        }
