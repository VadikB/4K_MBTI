      "required": [
        "indicator_id",
        "m2_version",
        "skill_id",
        "component_id",
        "observation_condition",
        "scenario_locations",
        "branch_condition",
        "event_condition",
        "observable_action",
        "validity_risk",
        "source"
      ],
      "title": "IndicatorTargetV2",
      "type": "object"
    },
    "ScenarioStepV2": {
      "additionalProperties": false,
      "properties": {
        "code": {
