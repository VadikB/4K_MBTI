    "characters": {
      "items": {
        "$ref": "#/$defs/CaseCharacterV2"
      },
      "minItems": 1,
      "title": "Characters",
      "type": "array"
    },
    "format": {
      "minLength": 1,
      "title": "Format",
      "type": "string"
    },
    "indicator_targets": {
      "items": {
        "$ref": "#/$defs/IndicatorTargetV2"
      },
      "minItems": 1,
      "title": "Indicator Targets",
      "type": "array"
    },
    "materials": {
