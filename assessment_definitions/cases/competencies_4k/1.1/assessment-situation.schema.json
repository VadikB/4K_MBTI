{
  "$defs": {
    "AdmissionDecisionV2": {
      "additionalProperties": false,
      "properties": {
        "admitted": {
          "title": "Admitted",
          "type": "boolean"
        },
        "code": {
          "enum": [
            "ADMITTED",
            "CASE_NOT_ADMITTED",
            "AS_NOT_ADMITTED"
          ],
          "title": "Code",
          "type": "string"
        },
        "reasons": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "admitted",
        "code",
        "reasons"
      ],
      "title": "AdmissionDecisionV2",
      "type": "object"
    },
    "IndicatorTargetV2": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "pattern": "^K[1-4]\\.C\\d{2}$",
          "title": "Component Id",
          "type": "string"
        },
        "indicator_id": {
          "pattern": "^K[1-4]\\.I\\d{2}$",
          "title": "Indicator Id",
          "type": "string"
        },
        "m2_version": {
          "minLength": 1,
          "title": "M2 Version",
          "type": "string"
        },
        "observable_action": {
          "minLength": 1,
          "title": "Observable Action",
          "type": "string"
        },
        "observation_condition": {
          "minLength": 1,
          "title": "Observation Condition",
          "type": "string"
        },
        "skill_id": {
          "pattern": "^K[1-4]\\.\\d+$",
          "title": "Skill Id",
          "type": "string"
        },
        "validity_risk": {
          "minLength": 1,
          "title": "Validity Risk",
          "type": "string"
        }
      },
      "required": [
        "indicator_id",
        "m2_version",
        "skill_id",
        "component_id",
        "observation_condition",
        "observable_action",
        "validity_risk"
      ],
      "title": "IndicatorTargetV2",
      "type": "object"
    },
    "QAEvidenceV2": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "minLength": 1,
          "title": "Artifact Ref",
          "type": "string"
        },
        "checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ],
          "title": "Result",
          "type": "string"
        },
        "scope": {
          "enum": [
            "case_format",
            "case_dialogue",
            "assessment_situation"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "result",
        "artifact_ref",
        "checksum"
      ],
      "title": "QAEvidenceV2",
      "type": "object"
    },
    "Substitution": {
      "additionalProperties": false,
      "properties": {
        "slot": {
          "minLength": 1,
          "title": "Slot",
          "type": "string"
        },
        "source_checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Checksum",
          "type": "string"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "value",
        "source_path",
        "source_checksum"
      ],
      "title": "Substitution",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "checksum"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "admission": {
      "$ref": "#/$defs/AdmissionDecisionV2"
    },
    "assessment_situation_id": {
      "minLength": 1,
      "title": "Assessment Situation Id",
      "type": "string"
    },
    "base_role": {
      "minLength": 1,
      "title": "Base Role",
      "type": "string"
    },
    "case_ref": {
      "$ref": "#/$defs/VersionRef"
    },
    "execution_payload_ref": {
      "$ref": "#/$defs/VersionRef"
    },
    "indicator_targets": {
      "items": {
        "$ref": "#/$defs/IndicatorTargetV2"
      },
      "minItems": 1,
      "title": "Indicator Targets",
      "type": "array"
    },
    "methodology_refs": {
      "items": {
        "$ref": "#/$defs/VersionRef"
      },
      "minItems": 1,
      "title": "Methodology Refs",
      "type": "array"
    },
    "participant_payload": {
      "additionalProperties": true,
      "title": "Participant Payload",
      "type": "object"
    },
    "planned_minutes": {
      "exclusiveMinimum": 0,
      "title": "Planned Minutes",
      "type": "integer"
    },
    "profile_ref": {
      "$ref": "#/$defs/VersionRef"
    },
    "qa_evidence": {
      "items": {
        "$ref": "#/$defs/QAEvidenceV2"
      },
      "title": "Qa Evidence",
      "type": "array"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "substitutions": {
      "items": {
        "$ref": "#/$defs/Substitution"
      },
      "title": "Substitutions",
      "type": "array"
    }
  },
  "required": [
    "assessment_situation_id",
    "case_ref",
    "profile_ref",
    "methodology_refs",
    "base_role",
    "substitutions",
    "participant_payload",
    "execution_payload_ref",
    "planned_minutes",
    "indicator_targets",
    "qa_evidence",
    "admission"
  ],
  "title": "AssessmentSituationV2",
  "type": "object"
}
