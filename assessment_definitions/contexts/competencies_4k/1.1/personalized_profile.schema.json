{
  "$id": "m4-personalized-profile-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checksum": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "conflicts": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "content": {
      "additionalProperties": false,
      "description": "Только подтверждённый содержательный контекст без ФИО и контактов.",
      "properties": {
        "organization_context": {
          "type": "object"
        },
        "role_profile": {
          "type": "object"
        },
        "user_context": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "full_name"
                ]
              },
              {
                "required": [
                  "contacts"
                ]
              }
            ]
          },
          "type": "object"
        }
      },
      "required": [
        "organization_context",
        "role_profile",
        "user_context"
      ],
      "type": "object"
    },
    "methodology_version": {
      "const": "1.1"
    },
    "organization_id": {
      "minimum": 1,
      "type": "integer"
    },
    "provenance": {
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "sources": {
      "additionalProperties": false,
      "properties": {
        "organization_context": {
          "additionalProperties": false,
          "properties": {
            "checksum": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "version_id": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "version_id",
            "checksum"
          ],
          "type": "object"
        },
        "role_profile": {
          "additionalProperties": false,
          "properties": {
            "checksum": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "version_id": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "version_id",
            "checksum"
          ],
          "type": "object"
        },
        "user_context": {
          "additionalProperties": false,
          "properties": {
            "checksum": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "version_id": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "version_id",
            "checksum"
          ],
          "type": "object"
        }
      },
      "required": [
        "organization_context",
        "role_profile",
        "user_context"
      ],
      "type": "object"
    },
    "status": {
      "enum": [
        "ready",
        "blocked"
      ]
    }
  },
  "required": [
    "schema_version",
    "methodology_version",
    "organization_id",
    "status",
    "sources",
    "content",
    "provenance",
    "conflicts",
    "checksum"
  ],
  "title": "Снимок PersonalizedProfile M4",
  "type": "object"
}
