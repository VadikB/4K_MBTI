{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "methodology-package-v2.schema.json",
  "title": "Пакет методологии оценки версии схемы 2",
  "type": "object",
  "required": ["schema_version", "kind", "code", "database_version", "methodology_version", "status", "levels", "competencies"],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "methodology"},
    "code": {"type": "string", "minLength": 1},
    "database_version": {"type": "integer", "minimum": 1},
    "methodology_version": {"type": "string", "minLength": 1},
    "status": {"const": "draft"},
    "levels": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/levelL0"}, {"$ref": "#/$defs/levelL1"},
        {"$ref": "#/$defs/levelL2"}, {"$ref": "#/$defs/levelL3"}
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "competencies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/competency"}}
  },
  "additionalProperties": false,
  "$defs": {
    "levelBase": {
      "type": "object",
      "required": ["code", "order", "meaning"],
      "properties": {
        "code": {"type": "string"},
        "order": {"type": "integer", "minimum": 0, "maximum": 3},
        "meaning": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "levelL0": {"allOf": [{"$ref": "#/$defs/levelBase"}, {"properties": {"code": {"const": "L0"}, "order": {"const": 0}}}]},
    "levelL1": {"allOf": [{"$ref": "#/$defs/levelBase"}, {"properties": {"code": {"const": "L1"}, "order": {"const": 1}}}]},
    "levelL2": {"allOf": [{"$ref": "#/$defs/levelBase"}, {"properties": {"code": {"const": "L2"}, "order": {"const": 2}}}]},
    "levelL3": {"allOf": [{"$ref": "#/$defs/levelBase"}, {"properties": {"code": {"const": "L3"}, "order": {"const": 3}}}]},
    "agentReference": {
      "type": "object",
      "required": ["code", "version"],
      "properties": {"code": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}},
      "additionalProperties": false
    },
    "redFlag": {
      "type": "object",
      "required": ["code", "description"],
      "properties": {
        "code": {"type": "string", "pattern": "^RF-K[1-4]\\.I[0-9]{2}-[0-9]{2}$"},
        "description": {
          "type": "string",
          "minLength": 1,
          "not": {"anyOf": [{"pattern": "^[0-9]+$"}, {"pattern": "^RF-[A-Z0-9.]+-$"}]}
        }
      },
      "additionalProperties": false
    },
    "indicator": {
      "type": "object",
      "required": ["id", "name", "function", "product", "levels", "boundary", "evidence_pattern", "red_flags"],
      "properties": {
        "id": {"type": "string", "pattern": "^K[1-4]\\.I[0-9]{2}$"},
        "name": {"type": "string", "minLength": 1},
        "function": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "levels": {
          "type": "object",
          "required": ["L0", "L1", "L2", "L3"],
          "properties": {
            "L0": {"type": "string", "minLength": 1}, "L1": {"type": "string", "minLength": 1},
            "L2": {"type": "string", "minLength": 1}, "L3": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "boundary": {"type": "string", "minLength": 1},
        "evidence_pattern": {"type": "string", "minLength": 1},
        "red_flags": {"type": "array", "items": {"$ref": "#/$defs/redFlag"}}
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["id", "name", "definition", "indicators"],
      "properties": {
        "id": {"type": "string", "pattern": "^K[1-4]\\.C[0-9]{2}$"},
        "name": {"type": "string", "minLength": 1},
        "definition": {"type": "string"},
        "indicators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/indicator"}}
      },
      "additionalProperties": false
    },
    "skill": {
      "type": "object",
      "required": ["id", "name", "function", "product", "place_in_logic", "boundary", "components"],
      "properties": {
        "id": {"type": "string", "pattern": "^K[1-4]\\.[0-9]+$"},
        "name": {"type": "string", "minLength": 1},
        "function": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "place_in_logic": {"type": "string", "minLength": 1},
        "boundary": {"type": "string", "minLength": 1},
        "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}}
      },
      "additionalProperties": false
    },
    "competency": {
      "type": "object",
      "required": ["id", "code", "name", "definition", "function", "product", "logic", "evaluator", "evaluator_version", "agent_definition", "skills"],
      "properties": {
        "id": {"type": "string", "pattern": "^K[1-4]$"},
        "code": {"type": "string", "pattern": "^K[1-4]$"},
        "name": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "function": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "logic": {"type": "string", "minLength": 1},
        "evaluator": {"type": "string", "pattern": "^evaluation\\.[a-z0-9_]+$"},
        "evaluator_version": {"type": "integer", "minimum": 1},
        "agent_definition": {"$ref": "#/$defs/agentReference"},
        "skills": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/skill"}}
      },
      "additionalProperties": false
    }
  }
}
