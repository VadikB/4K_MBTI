{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["summary", "claims"],
  "additionalProperties": false,
  "properties": {
    "summary": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 4},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "skill_ids", "basis_refs", "text", "limitations", "context_refs"],
        "properties": {
          "kind": {"enum": ["observation", "explanation", "context", "limitation", "quote"]},
          "skill_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "basis_refs": {"type": "array", "items": {"type": "string"}},
          "text": {"type": "string", "minLength": 1},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "context_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
